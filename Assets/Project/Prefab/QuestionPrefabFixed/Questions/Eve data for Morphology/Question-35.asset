  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question-35
  m_EditorClassIdentifier: 
  questionText: 'Why do we warm the leaves with alcohol?

'
  referenceImage: {fileID: 0}
  explanationText: 'The hot water kills the leaf, while the alcohol breaks down chlorophyll.
    As a result of this, the leaf loses its green colour. The chlorophyll must be
    removed from the sample before the iodine test can be performed.

'
  options:
  - 'To remove the chlorophyll from the leaf. '
  - 'To remove the oxygen from the leaf. '
  - 'To remove the starch from the leaf. '
  - 'To remove the water from the leaf. '
  correctOptionIndex: 0
