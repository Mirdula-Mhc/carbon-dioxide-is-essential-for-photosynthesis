      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 25
    pageText: Drag on the tripod and wire gauze.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 0}
      stayInUpcomingPages: 0
      enableOnce: 1
      hasBeenEnabledOnce: 0
  - pageName: Page 26
    pageText: Drag on the tripod and wire gauze.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 27
    pageText: 'Drag the water-filled beaker over the

      burner to boil the water.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 28
    pageText: Tap on the boiling tube to remove it from the leaf.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 29
    pageText: Drag the leaf to the boiling water.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 30
    pageText: Drag the beaker from the tripod stand and keep it on the table.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 31
    pageText: Drag the alcohol towards an empty boiling tube to fill the half tube
      with alcohol.
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 32
    pageText: 'Drag the forceps towards the leaf to transfer it into

      the boiling
      tube with alcohol.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 33
    pageText: 'Drag the forceps towards the leaf to transfer it into

      the boiling
      tube with alcohol.'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
  - pageName: Page 34
    pageText: 'The boiling alcohol dissolves the chlorophyll and removes the green

      colour
      from the leaf. The leaf gets'
    showDialogBox: 1
    showAlternatePanels: 1
    alternatePanels:
    - panel: {fileID: 6392091246361555685}
      stayInUpcomingPages: 0
      enableOnce: 0
      hasBeenEnabledOnce: 0
